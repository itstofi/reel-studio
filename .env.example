# Copy to .env and fill in what you use. Never commit .env.
# Everything works offline without these keys except the features noted.

# ElevenLabs — Arabic/English TTS in a clone of Jweed's voice, and Scribe transcription.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Claude for planning/translation. Not needed when the Claude Code CLI is logged in
# (the app finds it in PATH or in the VS Code extension). Set only to use the API instead.
ANTHROPIC_API_KEY=
# CLAUDE_BIN=/path/to/claude
# REEL_CLAUDE_MODEL=claude-opus-5-5
# REEL_CLAUDE_EFFORT=medium

# Local Chatterbox TTS server (scripts/chatterbox.sh start)
CHATTERBOX_URL=http://127.0.0.1:8004

# Transcription engine: mlx (Apple Silicon, default) | faster | elevenlabs
REEL_ASR_ENGINE=mlx
REEL_ASR_MODEL=large-v3

# Web UI
REEL_HOST=127.0.0.1
REEL_PORT=8765
# REEL_PROJECTS_DIR=~/Movies/ReelStudio
